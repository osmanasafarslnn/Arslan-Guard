<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Arka plan katmanı: varsayılan koyu renk veya kullanıcının seçtiği resim.
         Şeffaflık burada uygulanır; ön plandaki PIN paneli her zaman opak kalır. -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#F0121212" />

    <!-- Ön plan PIN giriş paneli -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_rounded"
            android:padding="24dp"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/imgLockedAppIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/txtLockedAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enter_pin"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <!-- PIN giriş grubu -->
            <LinearLayout
                android:id="@+id/pinGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <EditText
                    android:id="@+id/editPin"
                    android:layout_width="200dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_pin_input"
                    android:gravity="center"
                    android:inputType="numberPassword"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:letterSpacing="0.4"
                    android:maxLength="8"
                    android:textCursorDrawable="@null" />

                <Button
                    android:id="@+id/btnUnlock"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/unlock"
                    android:textColor="@color/black"
                    android:background="@drawable/bg_button_accent" />

            </LinearLayout>

            <!-- Desen (Pattern) giriş grubu -->
            <com.arslan.guard.PatternLockView
                android:id="@+id/patternLockView"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wrong_pin"
                android:textColor="@color/warning"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
