<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F0121212"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgLockedAppIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtLockedAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_pin"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/editPin"
        android:layout_width="200dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_pin_input"
        android:gravity="center"
        android:inputType="numberPassword"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:letterSpacing="0.4"
        android:maxLength="8"
        android:textCursorDrawable="@null" />

    <TextView
        android:id="@+id/txtError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wrong_pin"
        android:textColor="@color/warning"
        android:textSize="12sp"
        android:layout_marginTop="10dp"
        android:visibility="invisible" />

    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/unlock"
        android:textColor="@color/black"
        android:background="@drawable/bg_button_accent" />

</LinearLayout>
